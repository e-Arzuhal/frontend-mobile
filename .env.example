# Copy this file to `.env` and update the value to match your backend host.
# Expo loads `.env` automatically; EXPO_PUBLIC_* vars are inlined into the
# JS bundle at build time and are also visible to config plugins during
# `expo prebuild`.
#
# This value is used by:
#   - src/config/api.config.js (HTTP base URL for release/APK builds)
#   - plugins/withAndroidCleartext.js (Android network_security_config domain
#     whitelist, required for plain-HTTP traffic on Android 9+)
#
# After changing this, re-run:
#   npx expo prebuild --clean
#   cd android && gradlew assembleRelease

EXPO_PUBLIC_API_BASE_URL=http://192.168.1.187:8080
